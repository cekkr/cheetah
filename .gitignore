cheetah-server
cheetah_data/*

# The Node binder has no dependencies, but a consumer may install into it.
binders/nodejs/node_modules/
binders/nodejs/package-lock.json

# The Python binder likewise: caches and editable installs are local artifacts.
binders/python/**/__pycache__/
binders/python/*.egg-info/
binders/python/.venv/

# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/
.DS_Store
